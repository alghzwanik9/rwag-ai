# Rwaq AI — Backend Environment Variables
# Copy to `.env` at the repository root and fill in your credentials.
# Never commit `.env` with real secrets to version control.

# AI Providers (server-side only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here
FAL_KEY=your_fal_api_key_here
GROQ_API_KEY=your_groq_api_key_here
STITCH_API_KEY=your_stitch_api_key_here

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Backend CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Path to Blender executable for 3D scene rendering/export
BLENDER_EXECUTABLE=blender
