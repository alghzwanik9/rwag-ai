# Rwaq AI — Frontend Environment Variables
# Copy to `frontend/.env.local` and fill in your credentials.
# Never commit `.env.local` with real secrets to version control.

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Supabase (public anon client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# FastAPI Backend Base URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Explicit opt-in local demo mode for judges (bypasses Clerk middleware on /studio & /studio2d;
# server-side /api/projects/save still requires Clerk authentication)
NEXT_PUBLIC_DEMO_MODE=false

# Server-side only API key for Next.js 2D studio route handler (never prefix with NEXT_PUBLIC_)
FAL_KEY=your_fal_api_key_here
